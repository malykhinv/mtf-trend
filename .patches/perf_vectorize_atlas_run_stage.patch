+    joined = state_frame.merge(
+        future_frame,
+        on=["event_id", "symbol", "snapshot_time_ms", "feature_cutoff_time_ms"],
+        how="inner",
+        validate="one_to_one",
+    ).merge(
+        feature_frame,
+        on=["event_id", "symbol", "snapshot_time_ms", "feature_cutoff_time_ms"],
+        how="inner",
