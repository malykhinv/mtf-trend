+    grouped = frame.groupby([context_column, "_outcome_bin"], dropna=False, sort=True)
+    rows: list[AtlasNatureRow] = []
+    for (context_value, outcome_bin), group in grouped:
+        rows.append(
+            AtlasNatureRow(
