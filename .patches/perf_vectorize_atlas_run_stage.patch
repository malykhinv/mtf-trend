+                    reclaim_rate=_series_bool_rate(group["_reclaimed_running_high"]),
+                    double_barrier_stop_first_rate=_series_bool_rate(group["_stop_first"]),
+                    dominant_outcome_bin=str(group["_outcome_bin"].value_counts().idxmax()),
+                )
+            )
+    return rows
