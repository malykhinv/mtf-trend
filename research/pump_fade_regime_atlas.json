    {"interaction_id": "extreme_activity_x_verticality_x_wick", "components": [{"feature_name": "rel_vol_phase", "bin_index": 4}, {"feature_name": "verticality", "bin_index": 3}, {"feature_name": "current_upper_wick_fraction", "bin_index": 3}], "rationale": "Extreme activity, verticality, and rejection jointly represent blow-off exhaustion."},
    {"interaction_id": "extreme_activity_x_drawdown_x_flow_decay", "components": [{"feature_name": "rel_vol_phase", "bin_index": 4}, {"feature_name": "close_drawdown_from_high", "bin_index": 2}, {"feature_name": "taker_decline", "bin_index": 2}], "rationale": "Extreme activity followed by structural loss and flow decay may isolate early fade."},
    {"interaction_id": "prior_fade_x_below_peak_x_wick", "components": [{"feature_name": "n_prior_fades_48h", "bin_index": 1}, {"feature_name": "prior_1_current_vs_peak", "bin_index": 1}, {"feature_name": "current_upper_wick_fraction", "bin_index": 3}], "rationale": "Prior resolved fade structure may become relevant when the new pump rejects below it."},
